# std64.fl — Falcon Standard Library, x86-64 Linux
# 64-bit counterpart of std.fl. Thin wrappers over the _flr_* symbols in flrt64.o.
# Import with:  import "std64"
#
#   falconc prog.fl -arch x86-64-linux -I. -o prog.s
#   as prog.s -o prog.o && as flrt64.s -o flrt64.o
#   ld flrt64.o prog.o -o prog
#
# Differences from std.fl: Linux x86-64 syscall numbers (write=1, read=0), and
# alloc()/free() use `long` because heap pointers are 64-bit.

# ── I/O ──────────────────────────────────────────────────────────────

func print_str(s: str) -> void {
    __syscall(1, 1, s, str_len(s))  # sys_write fd=1 buf=s len
}

func print(s: str) -> void {
    print_str(s)
    __syscall(1, 1, "\n", 1)
}

func print_int(n: int) -> void {
    print_str(int_to_str(n))
}

func print_var(s: generic) -> void {
    # Prints any value followed by a newline, picking the printer from its type:
    # int/long/bool/ptr as numbers, str as text, float/double with 6 decimals.
    # `generic` makes this a template: one concrete copy per argument type used.
    __print(s)
}

# ── Input (stdin) ─────────────────────────────────────────────────────

func read_line() -> str {
    # Reads one line from stdin (fd 0) into a fresh heap string. The trailing
    # "\n" (and a "\r" before it) is stripped. Lines of any length work.
    # At end of input it returns "" and stdin_eof() becomes 1.
    return _flr_read_line()
}

func stdin_eof() -> int {
    # 1 if the most recent read_line() hit end of input without reading any
    # data, else 0.
    return _flr_stdin_eof()
}

func input_str(prompt: str) -> str {
    print_str(prompt)
    return read_line()
}

func read_int() -> int {
    # Parsing stops at the first non-digit: "12abc" -> 12, "abc" -> 0.
    return str_to_int(read_line())
}

func input(prompt: str) -> int {
    print_str(prompt)
    return read_int()
}

# ── String utilities ──────────────────────────────────────────────────

func str_len(s: str) -> int {
    return _flr_str_len(s)
}

func str_eq(a: str, b: str) -> int {
    return _flr_str_eq(a, b)
}

func int_to_str(n: int) -> str {
    return _flr_int_to_str(n)
}

func str_to_int(s: str) -> int {
    return _flr_str_to_int(s)
}

# ── Math ──────────────────────────────────────────────────────────────

func abs(n: int) -> int {
    return _flr_abs(n)
}

func min(a: int, b: int) -> int {
    return _flr_min(a, b)
}

func max(a: int, b: int) -> int {
    return _flr_max(a, b)
}

# ── Memory ────────────────────────────────────────────────────────────

func alloc(size: int) -> long {
    # Returns a 64-bit pointer to size bytes of zero-initialised heap memory.
    return _flr_alloc(size)
}

func free(ptr: long) -> void {
    # No-op in the bump allocator. Provided so code is portable.
    _flr_free(ptr)
}

# ── Control ───────────────────────────────────────────────────────────

func exit(code: int) -> void {
    _flr_exit(code)
}

func assert(cond: int, msg: str) -> void {
    # If cond == 0 prints "assertion failed: <msg>" to stderr and exits(1).
    _flr_assert(cond, msg)
}
