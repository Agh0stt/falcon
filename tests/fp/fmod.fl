# EXPECT: 1.500000|-1.500000|1.500000|1.000000|1.250000|0.500000|0.100000
import "std"
func main() -> void {
    a: double = 7.5
    b: double = -7.5
    c: double = 2.0
    d: double = -2.0
    print(a % c)
    print(b % c)
    print(a % d)
    big: double = 10000000000.0
    print(big % 3.0)
    f: float = 5.25
    print(f % 2)
    x: double = 8.5
    x %= 2.0
    x %= 1.0
    print(x)
    y: double = 0.3
    print(y % 0.2)
}
