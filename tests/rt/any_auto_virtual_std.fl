# STDOUT: 42|hello|2.500000|1.500000|5000000000|1|3|3.500000|2|42
import "std"
func show(v: any) -> void {
    print(v)
}
func add(a: any, b: any) -> void {
    print(a + b)
}
func main() -> void {
    n: auto = 41
    n += 1
    s: auto = "hello"
    d: auto = 2.5d
    f: auto = 1.5
    big: auto = 5000000000
    c: auto = [1, 2, 3]
    show(n)
    show(s)
    show(d)
    show(f)
    show(big)
    show(true)
    add(1, 2)
    add(1.5d, 2)
    show(c[1])
    print_var(n)
}
