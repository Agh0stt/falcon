# LIBS: 1
# STDOUT: 16|7|1|23|alpha|beta|gamma|delta|0||1|alpha|beta|gamma|delta||-2|-2|-22|0|0|0|0|6|1|1|1|6|abcd|ef|0|1|bc|0|abcdef|abcdef!||0|0|1|0|0|to stdout
import "std"
import "io"
func main() -> void {
    p: str = "/tmp/falcon_io_test_v.txt"
    q: str = "/tmp/falcon_io_test_v_2.txt"
    d: str = "/tmp/falcon_io_dir_v"
    print_var(fio_write_file(p, "alpha\nbeta\ngamma"))
    print_var(fio_append_file(p, "\ndelta\n"))
    print_var(fio_exists(p))
    print_var(fio_size(p))
    fd: int = fio_open(p, "r")
    print_var(fio_read_line(fd))
    print_var(fio_read_line(fd))
    print_var(fio_read_line(fd))
    print_var(fio_read_line(fd))
    print_var(fio_eof())
    print_var(fio_read_line(fd))
    print_var(fio_eof())
    fio_close(fd)
    print_var(fio_read_file(p))
    print_var(fio_open("/tmp/falcon_no_such_dir/x", "r"))
    print_var(fio_error())
    print_var(fio_open(p, "zz"))
    print_var(fio_rename(p, q))
    print_var(fio_exists(p))
    print_var(fio_remove(q))
    print_var(fio_exists(q))
    print_var(fio_write_file(p, "x\r\ny\r\n"))
    fd = fio_open(p, "r")
    print_var(_flr_str_len(fio_read_line(fd)))
    print_var(_flr_str_len(fio_read_line(fd)))
    fio_read_line(fd)
    print_var(fio_eof())
    fio_close(fd)
    print_var(fio_write_file(p, "abcdef"))
    fd = fio_open(p, "r")
    print_var(fio_read(fd, 4))
    print_var(fio_read(fd, 10))
    print_var(_flr_str_len(fio_read(fd, 10)))
    print_var(fio_seek(fd, 1, 0))
    print_var(fio_read(fd, 2))
    print_var(fio_seek(fd, 0, 0))
    print_var(fio_read_all(fd))
    fio_close(fd)
    fd = fio_open(p, "a")
    fio_write_line(fd, "!")
    fio_close(fd)
    print_var(fio_read_file(p))
    print_var(fio_remove(p))
    print_var(fio_mkdir(d))
    print_var(fio_exists(d))
    print_var(fio_rmdir(d))
    print_var(fio_exists(d))
    fio_write_line(1, "to stdout")
}
